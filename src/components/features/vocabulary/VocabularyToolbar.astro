---
/**
 * VocabularyToolbar - 单词本工具栏组件
 *
 * 排序按钮（默认 / A-Z / 随机）+ 搜索框。
 * 排序按钮复用 FilterTabs 原子组件；
 * 交互逻辑见 public/js/vocabulary-page-handler.js（Swup 兼容）。
 */
import { FilterTabs } from "@components/atoms/filter-tabs";

import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

const sortTabs = [
	{ value: "original", label: i18n(I18nKey.vocabularySortDefault) },
	{ value: "az", label: i18n(I18nKey.vocabularySortAZ) },
	{ value: "random", label: i18n(I18nKey.vocabularySortRandom) },
];
---

<div
	class="card-base vocabulary-toolbar p-3 onload-animation"
	id="vocabulary-toolbar"
>
	<div class="flex flex-wrap items-center gap-2">
		<FilterTabs tabs={sortTabs} dataAttr="sort" activeValue="original" />
		<div class="flex-1 min-w-40">
			<div
				class="flex items-center h-10 px-3 rounded-lg
					bg-black/[0.04] hover:bg-black/[0.06] focus-within:bg-black/[0.06]
					dark:bg-white/5 dark:hover:bg-white/10 dark:focus-within:bg-white/10
					transition"
			>
				<iconify-icon
					icon="material-symbols:search"
					class="text-[1.25rem] text-black/30 dark:text-white/30 mr-2 pointer-events-none"
				/>
				<input
					id="vocab-search"
					type="search"
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					class="flex-1 text-sm bg-transparent outline-0"
					placeholder={i18n(I18nKey.vocabularySearchPlaceholder)}
				/>
			</div>
		</div>
	</div>
</div>

<style>
	.vocabulary-toolbar {
		margin-bottom: 1rem;
	}
	/* 输入文字使用中性色，不随主题色变化 */
	#vocab-search {
		color: rgb(0 0 0 / 0.65);
	}
	:global(.dark) #vocab-search {
		color: rgb(255 255 255 / 0.65);
	}
	/* 提示字与灰色背景融为一体 */
	#vocab-search::placeholder {
		color: rgb(0 0 0 / 0.35);
	}
	:global(.dark) #vocab-search::placeholder {
		color: rgb(255 255 255 / 0.35);
	}
	/* 隐藏 type="search" 自带的浏览器原生清除按钮，保持样式统一 */
	#vocab-search::-webkit-search-cancel-button {
		display: none;
	}
	#vocab-search::-webkit-search-decoration {
		display: none;
	}
</style>
