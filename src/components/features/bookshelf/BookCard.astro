---
/**
 * BookCard - 书籍卡片组件
 *
 * 用于"书架"页面，展示书籍封面（或占位卡片）、书名、作者、简介。
 * 点击卡片在新标签页打开 PDF 预览（浏览器原生 PDF 阅读器，零额外依赖）。
 *
 * 封面三种模式（book.cover）：
 * - "default"：客户端用 PDF 第一页渲染封面（动态加载 pdf.js，仅本地 PDF）
 * - "none"：占位卡片（书本图标 + 书名）
 * - 图片 URL：显示封面图，加载失败回退占位卡片
 */
import type { Book } from "@/data/bookshelf";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

interface Props {
	book: Book;
	/** 入场动画延迟（毫秒），由父组件按序传入实现交错入场 */
	animationDelay?: number;
}

const { book, animationDelay = 0 } = Astro.props;

// 解析封面模式
const cover = book.cover ?? "none";
const coverMode =
	cover === "default" || cover === "none" ? cover : "url";
const coverUrl = coverMode === "url" ? cover : "";
// default 模式仅支持本地 PDF（同源），外链 PDF 回退占位
const usePdfCover =
	coverMode === "default" && !/^https?:\/\//i.test(book.url);
---

<a
	href={book.url}
	target="_blank"
	rel="noopener noreferrer"
	class="book-card onload-animation group relative overflow-hidden bg-transparent rounded-xl border border-black/10 dark:border-white/10 transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
	style={`animation-delay: ${animationDelay}ms`}
>
	<!-- 封面区域 -->
	<div
		class="aspect-3/4 relative overflow-hidden rounded-lg"
		data-pdf-cover={usePdfCover ? book.url : undefined}
	>
		{
			coverMode === "url" ? (
				<img
					src={coverUrl}
					alt={book.title}
					class="w-full h-full object-cover pointer-events-none"
					loading="lazy"
					decoding="async"
					onerror="this.parentElement.classList.add('cover-error'); this.remove();"
				/>
			) : (
				<div class="book-cover-placeholder w-full h-full flex flex-col items-center justify-center gap-2 px-3 text-center">
					<iconify-icon
						icon="material-symbols:book-2"
						width="48"
						height="48"
					/>
					<p class="text-xs font-medium line-clamp-2">
						{book.title}
					</p>
				</div>
			)
		}
		<!-- 封面图/PDF渲染失败时的回退占位（由 onerror 或渲染脚本触发显示） -->
		<div
			class="book-cover-placeholder cover-fallback absolute inset-0 flex-col items-center justify-center gap-2 px-3 text-center pointer-events-none"
		>
			<iconify-icon
				icon="material-symbols:book-2"
				width="48"
				height="48"
			/>
			<p class="text-xs font-medium line-clamp-2">{book.title}</p>
		</div>

		<!-- PDF 标记 -->
		<div
			class="absolute top-2 right-2 px-2 py-0.5 rounded-full text-[0.65rem] font-semibold text-white bg-black/50 backdrop-blur-sm"
		>
			PDF
		</div>
	</div>

	<!-- 信息区域 -->
	<div class="book-info flex flex-col gap-1 mt-3">
		<h3 class="text-sm font-semibold line-clamp-2 text-black/80 dark:text-white/80 group-hover:text-[var(--primary)] transition-colors">
			{book.title}
		</h3>
		{
			book.author && (
				<p class="text-xs text-black/50 dark:text-white/50">
					{book.author}
				</p>
			)
		}
		{
			book.description && (
				<p
					class="text-xs text-black/45 dark:text-white/45 line-clamp-2"
					title={book.description}
				>
					{book.description}
				</p>
			)
		}
		<span class="text-xs mt-1 inline-flex items-center gap-0.5 text-[var(--primary)]">
			<iconify-icon icon="material-symbols:open-in-new" width="0.9rem" />
			{i18n(I18nKey.bookshelfRead)}
		</span>
	</div>

	<!-- 悬停主题色渐变覆盖层（技能卡片同款） -->
	<div class="absolute inset-0 bg-gradient-to-br from-[var(--primary)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-[var(--radius-large)]">
	</div>
</a>

<style>
	.book-card {
		display: block;
		padding: 0.75rem;
	}
	.book-cover-placeholder {
		background: var(--btn-regular-bg);
		color: rgb(0 0 0 / 0.2);
	}
	:global(.dark) .book-cover-placeholder {
		color: rgb(255 255 255 / 0.2);
	}
	/* 占位中的书名使用中性色（比图标略深，保证可读） */
	.book-cover-placeholder p {
		color: rgb(0 0 0 / 0.45);
	}
	:global(.dark) .book-cover-placeholder p {
		color: rgb(255 255 255 / 0.45);
	}
	/* 回退占位：默认隐藏，img onerror 或 PDF 渲染失败时容器加 cover-error 后显示 */
	.cover-fallback {
		display: none;
	}
	.cover-error .cover-fallback {
		display: flex;
	}
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
