---
import Link from "@components/atoms/Link/Link.astro";
import type { MapPost } from "./types";

interface Props {
	post: MapPost;
	viewPostText: string;
}

const { post, viewPostText } = Astro.props;
---

<div class="map-popup-row">
	<span class="map-popup-title">{post.title}</span>
	<Link href={post.url} variant="primary" class="map-popup-link">
		{viewPostText}
	</Link>
</div>
