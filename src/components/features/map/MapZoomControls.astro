---
import Icon from "@components/atoms/Icon/Icon.astro";

interface Props {
	zoomInLabel: string;
	zoomOutLabel: string;
	resetViewLabel: string;
}

const { zoomInLabel, zoomOutLabel, resetViewLabel } = Astro.props;
---

<div class="map-zoom">
	<button
		type="button"
		class="map-zoom-btn btn-card flex h-11 w-11 items-center justify-center rounded-lg text-[var(--primary)] active:scale-90"
		data-action="zoom-in"
		aria-label={zoomInLabel}
		title={zoomInLabel}
	>
		<Icon icon="material-symbols:zoom-in" class="text-xl" />
	</button>
	<button
		type="button"
		class="map-zoom-btn btn-card flex h-11 w-11 items-center justify-center rounded-lg text-[var(--primary)] active:scale-90"
		data-action="zoom-out"
		aria-label={zoomOutLabel}
		title={zoomOutLabel}
	>
		<Icon icon="material-symbols:zoom-out" class="text-xl" />
	</button>
	<button
		type="button"
		class="map-zoom-btn btn-card flex h-11 w-11 items-center justify-center rounded-lg text-[var(--primary)] active:scale-90"
		data-action="reset"
		aria-label={resetViewLabel}
		title={resetViewLabel}
	>
		<Icon icon="material-symbols:filter-center-focus" class="text-xl" />
	</button>
</div>

<style>
	.map-zoom {
		position: absolute;
		top: 16px;
		right: 16px;
		display: flex;
		gap: 6px;
		z-index: 1000;
		user-select: none;
	}
</style>
