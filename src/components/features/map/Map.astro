---
import Icon from "@components/atoms/Icon/Icon.astro";
import MapPopup from "./MapPopup.astro";
import MapZoomControls from "./MapZoomControls.astro";
import type { MapGroup, MapPost } from "./types";

interface Props {
	posts: MapPost[];
	emptyText: string;
	viewPostText: string;
	postsAtLocationText: string;
	zoomInLabel: string;
	zoomOutLabel: string;
	resetViewLabel: string;
	defaultCenter: { lat: number; lng: number };
	defaultZoom: number;
	minZoom: number;
	maxZoom: number;
}

const {
	posts = [],
	emptyText = "",
	viewPostText = "",
	postsAtLocationText = "",
	zoomInLabel = "",
	zoomOutLabel = "",
	resetViewLabel = "",
	defaultCenter,
	defaultZoom,
	minZoom,
	maxZoom,
} = Astro.props;

// 服务端按经纬度分组，弹窗内容服务端渲染到 <template> 中
const groups: MapGroup[] = [];
const groupMap = new Map<string, MapGroup>();
for (const post of posts) {
	const key = `${post.lat},${post.lng}`;
	let group = groupMap.get(key);
	if (!group) {
		group = { lat: post.lat, lng: post.lng, items: [] };
		groupMap.set(key, group);
		groups.push(group);
	}
	group.items.push(post);
}

const markerData = groups.map((group, index) => ({
	lat: group.lat,
	lng: group.lng,
	tpl: `map-popup-tpl-${index}`,
}));
---

<div class="map-page">
	{
		posts.length === 0 ? (
			<div class="flex flex-col items-center justify-center gap-3 px-4 py-20 text-center">
				<Icon
					icon="material-symbols:map-outline"
					class="text-6xl text-black/15 dark:text-white/20"
				/>
				<p class="text-lg text-black/45 dark:text-white/50">{emptyText}</p>
			</div>
		) : (
			<>
				<div id="footprint-map" class="map-container" />
				<MapZoomControls
					zoomInLabel={zoomInLabel}
					zoomOutLabel={zoomOutLabel}
					resetViewLabel={resetViewLabel}
				/>
				{groups.map((group, index) => (
					<template id={`map-popup-tpl-${index}`}>
						<MapPopup
							group={group}
							viewPostText={viewPostText}
							postsAtLocationText={postsAtLocationText}
						/>
					</template>
				))}
			</>
		)
	}
</div>

<script is:inline define:vars={{ markerData, defaultCenter, defaultZoom, minZoom, maxZoom }}>
	(function () {
		"use strict";

		var CONTAINER_ID = "footprint-map";
		var LEAFLET_CSS_URL = "/vendor/leaflet/leaflet.css";
		var LEAFLET_JS_URL = "/vendor/leaflet/leaflet.js";
		var LEAFLET_CSS_ID = "leaflet-css-loaded";
		var LEAFLET_JS_ID = "leaflet-script-loaded";
		var MAP_STORE_KEY = "__mizukiFootprintMap";
		var LEAFLET_WAIT_TIMEOUT = 10000;

		function loadStylesheet(url, id) {
			return new Promise(function (resolve) {
				if (document.getElementById(id)) {
					resolve();
					return;
				}
				var link = document.createElement("link");
				link.id = id;
				link.rel = "stylesheet";
				link.href = url;
				link.onload = function () {
					resolve();
				};
				link.onerror = function () {
					resolve();
				};
				document.head.appendChild(link);
			});
		}

		function loadScript(url, id) {
			return new Promise(function (resolve, reject) {
				if (document.getElementById(id)) {
					resolve();
					return;
				}
				var script = document.createElement("script");
				script.id = id;
				script.src = url;
				script.onload = function () {
					resolve();
				};
				script.onerror = function () {
					reject(new Error("无法加载 " + url));
				};
				document.head.appendChild(script);
			});
		}

		// 脚本标签已存在但尚未加载完成时，有界等待全局 L 就绪
		function waitForLeaflet(timeout) {
			return new Promise(function (resolve, reject) {
				var start = Date.now();
				(function check() {
					if (typeof L !== "undefined") {
						resolve();
						return;
					}
					if (Date.now() - start > timeout) {
						reject(new Error("Leaflet 加载超时"));
						return;
					}
					requestAnimationFrame(check);
				})();
			});
		}

		function destroyMap() {
			var map = window[MAP_STORE_KEY];
			if (map) {
				map.remove();
				window[MAP_STORE_KEY] = null;
			}
		}

		function cleanupWhenContainerRemoved() {
			if (!document.getElementById(CONTAINER_ID)) {
				destroyMap();
			}
		}

		function registerCleanup() {
			if (window.swup && window.swup.hooks) {
				window.swup.hooks.on("content:replace", cleanupWhenContainerRemoved);
			} else {
				document.addEventListener(
					"swup:enable",
					function () {
						if (window.swup && window.swup.hooks) {
							window.swup.hooks.on(
								"content:replace",
								cleanupWhenContainerRemoved,
							);
						}
					},
					{ once: true },
				);
			}
			window.addEventListener("beforeunload", destroyMap);
		}

		function initMap() {
			var container = document.getElementById(CONTAINER_ID);
			if (!container) {
				return;
			}

			destroyMap();

			// 缩放级别钳制到配置范围内
			var initialZoom = Math.min(
				Math.max(defaultZoom, minZoom),
				maxZoom,
			);
			var initialCenter = [defaultCenter.lat, defaultCenter.lng];

			var map = L.map(container, {
				scrollWheelZoom: false,
				zoomControl: false,
				attributionControl: false,
				minZoom: minZoom,
				maxZoom: maxZoom,
			});
			map.setView(initialCenter, initialZoom);
			window[MAP_STORE_KEY] = map;

			// 位置数据范围：中国 + 日本
			map.setMaxBounds(
				L.latLngBounds([
					[16, 72],
					[56, 152],
				]),
			);

			// 本地离线瓦片：z4-6 广域覆盖，z7-9 为东部中国细节瓦片
			L.tileLayer("/tiles/{z}/{x}/{y}.png", {
				minZoom: minZoom,
				maxZoom: maxZoom,
				noWrap: true,
				bounds: L.latLngBounds([
					[15, 70],
					[56, 170],
				]),
			}).addTo(map);

			// 点击地图后启用滚轮缩放，鼠标移出后禁用，避免滚动页面时被地图卡住
			container.addEventListener("click", function () {
				map.scrollWheelZoom.enable();
			});
			container.addEventListener("mouseleave", function () {
				map.scrollWheelZoom.disable();
			});

			var dotIcon = L.divIcon({
				className: "map-marker-root",
				html: "",
				iconSize: [14, 14],
				iconAnchor: [7, 7],
				popupAnchor: [0, -10],
			});

			markerData.forEach(function (marker) {
				var template = document.getElementById(marker.tpl);
				var popupNode = template
					? template.content.firstElementChild
					: null;
				if (!popupNode) {
					return;
				}
				L.marker([marker.lat, marker.lng], { icon: dotIcon })
					.bindPopup(popupNode, { maxWidth: 280, className: "map-popup" })
					.addTo(map);
			});

			function resetView() {
				map.setView(initialCenter, initialZoom);
				map.invalidateSize();
			}

			// 缩放按钮：事件委托，单监听器避免重复绑定
			var page = container.closest(".map-page");
			var controls = page ? page.querySelector(".map-zoom") : null;
			if (controls) {
				controls.addEventListener("click", function (event) {
					var target = event.target instanceof Element ? event.target : null;
					var btn = target ? target.closest("[data-action]") : null;
					if (!btn) {
						return;
					}
					var action = btn.getAttribute("data-action");
					if (action === "zoom-in") {
						map.zoomIn();
					} else if (action === "zoom-out") {
						map.zoomOut();
					} else if (action === "reset") {
						resetView();
					}
				});
			}

			registerCleanup();
		}

		loadStylesheet(LEAFLET_CSS_URL, LEAFLET_CSS_ID)
			.then(function () {
				return loadScript(LEAFLET_JS_URL, LEAFLET_JS_ID);
			})
			.then(function () {
				return waitForLeaflet(LEAFLET_WAIT_TIMEOUT);
			})
			.then(initMap)
			.catch(function (error) {
				console.error("[FootprintMap] 初始化失败:", error);
			});
	})();
</script>

<style>
	.map-page {
		position: relative;
	}

	.map-container {
		width: 100%;
		height: clamp(22rem, 50vh, 38rem);
		border-radius: var(--radius-large, 1rem);
		overflow: hidden;
		padding: 8px;
		background: color-mix(in oklch, var(--card-bg) 92%, transparent);
	}
</style>
