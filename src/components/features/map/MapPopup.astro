---
import Link from "@components/atoms/Link/Link.astro";
import MapPopupItem from "./MapPopupItem.astro";
import type { MapGroup } from "./types";

interface Props {
	group: MapGroup;
	viewPostText: string;
	postsAtLocationText: string;
}

const { group, viewPostText, postsAtLocationText } = Astro.props;
---

<div class="map-popup">
	{
		group.items.length === 1 ? (
			<>
				<div class="map-popup-title">{group.items[0].title}</div>
				<Link href={group.items[0].url} variant="primary" class="map-popup-link">
					{viewPostText}
				</Link>
			</>
		) : (
			<>
				<div class="map-popup-title">
					{group.items.length} {postsAtLocationText}
				</div>
				<div class="map-popup-list">
					{group.items.map((post) => (
						<MapPopupItem post={post} viewPostText={viewPostText} />
					))}
				</div>
			</>
		)
	}
</div>
