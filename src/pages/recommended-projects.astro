---
import { PageHeader } from "@components/features/page-header";
import { ProjectCard } from "@components/features/projects";
import MainGridLayout from "@layouts/MainGridLayout.astro";

import { recommendedProjectsData } from "../data/recommended-projects";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.recommendedProjects) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.recommendedProjects);
const subtitle = i18n(I18nKey.recommendedProjectsSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader title={title} subtitle={subtitle} />

			{
				recommendedProjectsData.length > 0 ? (
					<div
						id="recommended-projects-grid"
						class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start"
					>
						{recommendedProjectsData.map((project) => (
							<ProjectCard project={project} maxTechStack={4} />
						))}
					</div>
				) : (
					<div class="text-center py-16">
						<iconify-icon
							icon="material-symbols:star-outline-rounded"
							width="64"
							height="64"
							class="text-black/15 dark:text-white/15 mb-4"
						></iconify-icon>
						<p class="text-black/40 dark:text-white/40 text-lg">
							{i18n(I18nKey.noData)}
						</p>
					</div>
				)
			}
		</div>
	</div>
</MainGridLayout>
