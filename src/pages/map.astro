---
import "../styles/map.css";

import { Map } from "@components/features/map";
import { PageHeader } from "@components/features/page-header";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { MapConfig, siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getSortedPostsList, parseLocation } from "@utils/content-utils";

if (!siteConfig.featurePages.footprint) {
	return Astro.redirect("/404/");
}

const allPosts = await getSortedPostsList();

const posts = allPosts
	.map((post) => {
		const location = parseLocation(post.data.location);
		if (!location) return null;
		return {
			id: post.id,
			title: post.data.title,
			url: post.url ?? `/posts/${post.id}/`,
			lat: location.lat,
			lng: location.lng,
		};
	})
	.filter((post): post is NonNullable<typeof post> => post !== null);

const title = i18n(I18nKey.footprint);
const subtitle = i18n(I18nKey.footprintSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative"
	>
		<div class="card-base z-10 p-6 sm:p-9 relative w-full">
			<PageHeader title={title} subtitle={subtitle} />

			<Map
				posts={posts}
				emptyText={i18n(I18nKey.footprintEmpty)}
				viewPostText={i18n(I18nKey.footprintViewPost)}
				postsAtLocationText={i18n(I18nKey.footprintPostsAtLocation)}
				zoomInLabel={i18n(I18nKey.footprintZoomIn)}
				zoomOutLabel={i18n(I18nKey.footprintZoomOut)}
				resetViewLabel={i18n(I18nKey.footprintResetView)}
				defaultCenter={{ lat: MapConfig.defaultCenter.lat, lng: MapConfig.defaultCenter.lng }}
				defaultZoom={MapConfig.defaultCenter.zoom}
				minZoom={MapConfig.minZoom}
				maxZoom={MapConfig.maxZoom}
			/>
		</div>
	</div>
</MainGridLayout>
