---
import { PageHeader } from "@components/features/page-header";
import HomeTabBar from "@components/features/posts/HomeTabBar.astro";
import { ScheduleTimeline } from "@components/features/schedule";
import MainGridLayout from "@layouts/MainGridLayout.astro";

import { siteConfig } from "../config";
import { scheduleData } from "../data/schedule";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.schedule) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.schedule);
const subtitle = i18n(I18nKey.scheduleSubtitle);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<!-- 日程簿折叠/定位交互（Swup 兼容的经典脚本，切页时重新执行） -->
	<script is:inline src="/js/schedule-page-handler.js"></script>

	<HomeTabBar />

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-6 sm:px-9 py-6 relative w-full">
			<PageHeader title={title} subtitle={subtitle} />

			{
				scheduleData.length > 0 ? (
					<ScheduleTimeline items={scheduleData} />
				) : (
					<div class="text-center py-16">
						<iconify-icon
							icon="material-symbols:calendar-month"
							width="64"
							height="64"
							class="text-black/15 dark:text-white/15 mb-4"
						></iconify-icon>
						<p class="text-black/40 dark:text-white/40 text-lg">
							{i18n(I18nKey.noData)}
						</p>
					</div>
				)
			}
		</div>
	</div>
</MainGridLayout>
